---
import '../styles/globals.css';
// Arabic-first fonts (with Latin fallbacks bundled in the same families)
import '@fontsource/tajawal/arabic-400.css';
import '@fontsource/tajawal/arabic-500.css';
import '@fontsource/tajawal/arabic-700.css';
import '@fontsource/tajawal/latin-400.css';
import '@fontsource/tajawal/latin-700.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/arabic-800.css';
import '@fontsource/cairo/latin-700.css';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'توب تن للأسر المنتجة | من القوع إلى بيوت الناس',
    description = 'توب تن محل في القوع يدعم الأسر المنتجة في بيع الأطعمة الشعبية، الحلويات، القهوة والمشروبات — طعم محلي وأثر مستدام.'
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#a6783f" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:locale" content="ar_AE" />
    </head>
    <body class="bg-background text-foreground font-sans antialiased">
        <slot />

        <script is:inline>
            // Scroll-reveal: reveal elements as they enter the viewport.
            const reveal = () => {
                const els = document.querySelectorAll('.reveal');
                if (!('IntersectionObserver' in window) || !els.length) {
                    els.forEach((el) => el.classList.add('is-visible'));
                    return;
                }
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('is-visible');
                                io.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
                );
                els.forEach((el) => io.observe(el));
            };
            reveal();
            document.addEventListener('astro:after-swap', reveal);
        </script>
    </body>
</html>
