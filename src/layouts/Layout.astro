---
import '../../src/styles/globals.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title?: string;
    description?: string;
}

const { title = 'حكايتي — قصص وأفلام كرتون مخصصة لطفلك', description = 'حول صورة طفلك إلى قصة وفيلم كرتوني متحرك بلمسة سحرية. تعليمية، ترفيهية، ومليئة بالقيم الأخلاقية.' } = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl">
    <head>
        <meta charset="UTF-8" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#1f5235" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@400;600;700;900&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="antialiased">
        <div class="flex flex-col min-h-screen">
            <Header />
            <main class="grow"><slot /></main>
            <Footer />
        </div>
    </body>
</html>
