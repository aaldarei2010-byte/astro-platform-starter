---
// Real photo with a graceful, on-brand fallback.
// Renders the branded PlaceholderImage underneath, then an <img> on top.
// If the image fails to load it is removed, revealing the fallback — so the
// page never shows a broken-image icon.
import PlaceholderImage from './PlaceholderImage.astro';

type Kind = 'coffee' | 'sweets' | 'food' | 'sandwich' | 'gift' | 'store' | 'package' | 'gallery';

interface Props {
    src: string;
    alt: string;
    kind?: Kind;
    label?: string;
    ratio?: string;
    class?: string;
}

const { src, alt, kind = 'food', label = '', ratio = 'aspect-[4/3]', class: className = '' } = Astro.props;
---

<figure class={`relative m-0 overflow-hidden rounded-2xl ${ratio} ${className}`}>
    <PlaceholderImage kind={kind} label={label} note="" fill />
    <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
        onerror="this.remove()"
    />
</figure>
