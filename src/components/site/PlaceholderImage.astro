---
// On-brand image placeholder.
// Renders a warm gradient + a category icon + a label so the page never shows a
// broken image. Replace with a real photo by swapping this component for:
//   <img src="/images/topten/your-photo.jpg" alt="..." class="..." />
type Kind =
    | 'coffee'
    | 'sweets'
    | 'food'
    | 'sandwich'
    | 'gift'
    | 'store'
    | 'package'
    | 'gallery';

interface Props {
    label?: string;
    note?: string;
    kind?: Kind;
    class?: string;
    ratio?: string; // e.g. "aspect-[4/3]" | "aspect-square"
    fill?: boolean; // absolutely fill the parent (used as an <img> fallback layer)
}

const { label = '', note = 'صورة توضيحية — استبدلها بصورة حقيقية', kind = 'food', class: className = '', ratio = 'aspect-[4/3]', fill = false } = Astro.props;

const gradients: Record<Kind, string> = {
    coffee: 'from-[#6f4e2e] to-[#a6783f]',
    sweets: 'from-[#b9823f] to-[#e0b56a]',
    food: 'from-[#8a5a32] to-[#c8a24b]',
    sandwich: 'from-[#a6783f] to-[#d8b066]',
    gift: 'from-[#5a3a22] to-[#9a6b3c]',
    store: 'from-[#7a5733] to-[#c8a24b]',
    package: 'from-[#8a6238] to-[#caa15a]',
    gallery: 'from-[#6f4e2e] to-[#caa15a]'
};

// Simple line icons (stroke = currentColor)
const icons: Record<Kind, string> = {
    coffee: '<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Z"/><path d="M17 10h2.5a2.5 2.5 0 0 1 0 5H17"/><path d="M7 4c0 .8-.6 1.2-.6 2s.6 1.2.6 2"/><path d="M11 4c0 .8-.6 1.2-.6 2s.6 1.2.6 2"/>',
    sweets: '<circle cx="12" cy="12" r="8"/><circle cx="9.5" cy="10" r="1"/><circle cx="14" cy="9.5" r="1"/><circle cx="13.5" cy="14" r="1"/><circle cx="9.5" cy="14.5" r="1"/>',
    food: '<path d="M5 3v8a3 3 0 0 0 3 3v7"/><path d="M5 3l0 0"/><path d="M8 3v5"/><path d="M11 3v5"/><path d="M19 3c-1.7 0-3 2-3 5s1 4 2 4v9"/>',
    sandwich: '<path d="M3 11h18l-2-3a4 4 0 0 0-3-2H8a4 4 0 0 0-3 2l-2 3Z"/><path d="M3 11h18"/><path d="M4 14h16a2 2 0 0 1 2 2 2 2 0 0 1-2 2H4a2 2 0 0 1-2-2 2 2 0 0 1 2-2Z"/>',
    gift: '<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M2 9h20v3H2z"/><path d="M12 9v11"/><path d="M12 9S10.5 4 8 4a2 2 0 0 0 0 5"/><path d="M12 9s1.5-5 4-5a2 2 0 0 1 0 5"/>',
    store: '<path d="M4 9h16l-1-4H5L4 9Z"/><path d="M4 9v10h16V9"/><path d="M9 19v-5h6v5"/>',
    package: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M4 7.5 12 12l8-4.5"/><path d="M12 12v9"/>',
    gallery: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="m21 16-5-5L5 20"/>'
};

const root = fill
    ? `absolute inset-0 h-full w-full overflow-hidden bg-gradient-to-br ${gradients[kind]} ${className}`
    : `relative overflow-hidden rounded-2xl bg-gradient-to-br ${gradients[kind]} ${ratio} ${className}`;
---

<div class={root}>
    <!-- subtle texture -->
    <div class="absolute inset-0 opacity-[0.12]" style="background-image: radial-gradient(circle at 20% 20%, white 1px, transparent 1px); background-size: 14px 14px;">
    </div>
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-5 text-center text-white">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="opacity-90"
            set:html={icons[kind]}
        />
        {label && <span class="font-display text-lg font-bold drop-shadow-sm">{label}</span>}
        <span class="text-[11px] font-medium opacity-75">{note}</span>
    </div>
</div>
