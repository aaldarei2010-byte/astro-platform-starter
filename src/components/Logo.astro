---
interface Props {
    variant?: 'dark' | 'light';
}
const { variant = 'dark' } = Astro.props;
const textColor = variant === 'dark' ? 'text-brand-700' : 'text-cream-100';
const subColor = variant === 'dark' ? 'text-brand-500' : 'text-cream-200';
---

<div class="flex items-center gap-3">
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
            d="M6 14.5c0-1.1.9-2 2-2h11c2.5 0 4.5 2 4.5 4.5v20.5c0-2.5-2-4.5-4.5-4.5H8c-1.1 0-2-.9-2-2V14.5z"
            fill="#1f5235"></path>
        <path
            d="M42 14.5c0-1.1-.9-2-2-2H29c-2.5 0-4.5 2-4.5 4.5v20.5c0-2.5 2-4.5 4.5-4.5h11c1.1 0 2-.9 2-2V14.5z"
            fill="#2d6b44"></path>
        <path
            d="M24 6.5l2 4.7 5 .5-3.8 3.4 1.1 4.9L24 17.5l-4.3 2.5 1.1-4.9L17 11.7l5-.5L24 6.5z"
            fill="#e4b558"></path>
    </svg>
    <div class="flex flex-col leading-tight">
        <span class={`text-2xl font-black ${textColor}`}>حكايتي</span>
        <span class={`text-xs font-bold tracking-widest ${subColor}`}>Hikayati</span>
    </div>
</div>
