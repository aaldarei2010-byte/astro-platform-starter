---
import Logo from './Logo.astro';

const columns = [
    {
        title: 'حكايتي',
        links: [
            { text: 'قصصنا', href: '/stories' },
            { text: 'كيف يعمل', href: '/how-it-works' },
            { text: 'المكتبة', href: '/library' },
            { text: 'أسعار', href: '/pricing' }
        ]
    },
    {
        title: 'الشركة',
        links: [
            { text: 'من نحن', href: '/stories' },
            { text: 'تواصل معنا', href: 'mailto:hello@hikayati.com' },
            { text: 'المدارس والروضات', href: '/pricing#schools' },
            { text: 'الخصوصية', href: '#' }
        ]
    }
];
---

<footer class="bg-cream-200 mt-24">
    <div class="container-page py-16 grid gap-12 md:grid-cols-[1.3fr_1fr_1fr_1.2fr]">
        <div>
            <Logo />
            <p class="mt-4 text-brand-600 leading-relaxed max-w-xs">
                حول صورة طفلك إلى بطل في قصة وفيلم كرتوني مليء بالقيم الأخلاقية.
            </p>
            <p class="mt-4 text-sm text-brand-500">www.hikayati.com</p>
            <div class="flex items-center gap-3 mt-4 text-brand-700">
                <a href="#" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white flex items-center justify-center hover:bg-brand-600 hover:text-cream-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h3l1-4h-4V7.5c0-1.1.4-2 2-2h2V2h-3c-3 0-5 1.8-5 5v3H6v4h3v8h4z"/></svg>
                </a>
                <a href="#" aria-label="Instagram" class="w-9 h-9 rounded-full bg-white flex items-center justify-center hover:bg-brand-600 hover:text-cream-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                </a>
                <a href="#" aria-label="TikTok" class="w-9 h-9 rounded-full bg-white flex items-center justify-center hover:bg-brand-600 hover:text-cream-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3v3a4 4 0 0 0 4 4v3a7 7 0 0 1-4-1.3V16a6 6 0 1 1-6-6v3a3 3 0 1 0 3 3V3h3z"/></svg>
                </a>
                <a href="#" aria-label="YouTube" class="w-9 h-9 rounded-full bg-white flex items-center justify-center hover:bg-brand-600 hover:text-cream-100">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12s0-3.5-.5-5.1a2.7 2.7 0 0 0-1.9-1.9C17.7 4.5 12 4.5 12 4.5s-5.7 0-7.6.5A2.7 2.7 0 0 0 2.5 6.9C2 8.5 2 12 2 12s0 3.5.5 5.1a2.7 2.7 0 0 0 1.9 1.9c1.9.5 7.6.5 7.6.5s5.7 0 7.6-.5a2.7 2.7 0 0 0 1.9-1.9C22 15.5 22 12 22 12zm-12 3.3V8.7l5.5 3.3-5.5 3.3z"/></svg>
                </a>
            </div>
        </div>
        {
            columns.map((col) => (
                <div>
                    <h4 class="text-brand-800 font-extrabold mb-4">{col.title}</h4>
                    <ul class="space-y-2 text-brand-600">
                        {col.links.map((l) => (
                            <li>
                                <a href={l.href} class="hover:text-accent-500">
                                    {l.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
        <div>
            <h4 class="text-brand-800 font-extrabold mb-4">النشرة البريدية</h4>
            <p class="text-brand-600 text-sm mb-3">اشترك لتصلك قصص جديدة وعروض خاصة.</p>
            <form class="flex gap-2" onsubmit="event.preventDefault(); this.querySelector('button').innerText='تم الاشتراك';">
                <input type="email" required placeholder="بريدك الإلكتروني" class="input flex-1 text-sm" />
                <button type="submit" class="btn btn-primary">اشترك</button>
            </form>
        </div>
    </div>
    <div class="border-t border-brand-100">
        <div class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-brand-600">
            <p>© {new Date().getFullYear()} حكايتي. جميع الحقوق محفوظة.</p>
            <p>صُنع بحب للأطفال في الإمارات والعالم العربي.</p>
        </div>
    </div>
</footer>
