---
import Layout from '../layouts/Layout.astro';

const steps = [
    {
        num: '١',
        title: 'ارفع الصورة',
        desc: 'يرفع الوالد صورة واضحة للطفل عبر واجهة آمنة ومشفرة. الصور لا تُشارك مع أي طرف ثالث.',
        emoji: '📸'
    },
    {
        num: '٢',
        title: 'الذكاء الاصطناعي يصنع القصة',
        desc: 'تحلل الخوارزميات ملامح الطفل وتحوّله إلى شخصية كرتونية جذابة داخل قصة مصممة حول قيمة أخلاقية تختارها.',
        emoji: '🪄'
    },
    {
        num: '٣',
        title: 'شاهد كرتون طفلك',
        desc: 'في دقائق يصبح الكتاب أو الفيلم جاهزاً للمشاهدة والتحميل والمشاركة مع العائلة.',
        emoji: '🎬'
    }
];

const tech = [
    { title: 'ذكاء اصطناعي توليدي', desc: 'يُنشئ شخصية كرتونية تشبه طفلك بدقة عالية.', icon: '🧠' },
    { title: 'تخصيص كامل', desc: 'اختر القيمة، البيئة (غابة/مدينة/بحر/صحراء)، واللهجة.', icon: '🎨' },
    { title: 'أمان وخصوصية', desc: 'معالجة آمنة للصور وحماية كاملة لبيانات الأطفال.', icon: '🔒' },
    { title: 'دعم اللغة العربية كاملاً', desc: 'قصص وواجهة بالعربية الفصحى ولهجات متعددة.', icon: '🗣️' },
    { title: 'متوافق مع كل الأجهزة', desc: 'تجربة سلسة على الهاتف والجهاز اللوحي والحاسوب.', icon: '📱' },
    { title: 'تسليم سريع', desc: 'قصة كتاب جاهزة خلال دقائق، فيلم خلال أقل من ساعة.', icon: '⚡' }
];
---

<Layout title="كيف يعمل — حكايتي">
    <section class="section bg-cream-100">
        <div class="container-page text-center max-w-3xl mx-auto">
            <span class="inline-block bg-brand-50 text-brand-600 text-sm font-bold px-4 py-1.5 rounded-full mb-4">آلية العمل</span>
            <h1 class="text-brand-800">ثلاث خطوات فقط لتحويل طفلك إلى بطل قصته</h1>
            <p class="mt-4 text-brand-600 text-lg leading-relaxed">
                من الصورة إلى الكرتون المتحرك، تجربة بسيطة ومرحة يحبها الآباء والأطفال.
            </p>
        </div>
    </section>

    <section class="pb-24 bg-cream-100">
        <div class="container-page space-y-8">
            {
                steps.map((step, i) => (
                    <div class={`card flex flex-col md:flex-row items-center gap-8 ${i % 2 === 0 ? '' : 'md:flex-row-reverse'}`}>
                        <div class="shrink-0 w-24 h-24 rounded-3xl bg-brand-600 text-cream-100 flex items-center justify-center text-5xl font-black">
                            {step.num}
                        </div>
                        <div class="flex-1 text-center md:text-right">
                            <div class="text-5xl mb-2">{step.emoji}</div>
                            <h2 class="text-brand-800 mb-3">{step.title}</h2>
                            <p class="text-brand-600 leading-relaxed">{step.desc}</p>
                        </div>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="section bg-white">
        <div class="container-page">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-brand-800">المميزات التقنية</h2>
                <p class="mt-3 text-brand-600">تقنيات متطورة في خدمة محتوى نظيف ومفيد لطفلك.</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    tech.map((t) => (
                        <div class="card border border-brand-50">
                            <div class="text-3xl mb-3">{t.icon}</div>
                            <h3 class="text-brand-800 font-extrabold text-lg mb-2">{t.title}</h3>
                            <p class="text-brand-600 text-sm leading-relaxed">{t.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-page">
            <div class="rounded-[40px] bg-brand-600 p-10 sm:p-16 text-center text-cream-100">
                <h2 class="text-cream-100">جاهز للبدء؟</h2>
                <p class="mt-3 text-cream-200">اختر كتاباً أو فيلماً وابدأ رحلة طفلك كبطل.</p>
                <div class="mt-6"><a href="/create" class="btn btn-accent btn-lg">ابدأ الآن</a></div>
            </div>
        </div>
    </section>
</Layout>
