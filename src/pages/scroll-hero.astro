---
import SiteLayout from '../layouts/SiteLayout.astro';
import Demo from '../components/examples/scroll-morph-hero-demo.tsx';
---

<SiteLayout title="توب تن | عرض الرفوف التفاعلي">
    <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
        <div class="mb-8 text-center">
            <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">عرض تفاعلي</span>
            <h1 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">رفوفنا بحركة</h1>
            <p class="mt-4 text-lg text-muted-foreground">مرّر داخل الإطار بالماوس أو باللمس لتتحوّل الصور من دائرة إلى قوس.</p>
        </div>

        <Demo client:only="react" />
    </main>
</SiteLayout>
