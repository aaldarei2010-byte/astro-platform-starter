---
import Layout from '../layouts/Layout.astro';

const values = [
    { title: 'الصدق والأمانة', desc: 'قصص تُبرز أهمية قول الحقيقة والوفاء بالوعود، يعيشها الطفل بنفسه كبطل القصة.', icon: '⭐', color: 'bg-amber-100' },
    { title: 'مساعدة الآخرين', desc: 'مغامرات تُشجع على التعاون وتقديم يد العون، مما يُرسّخ روح التضامن منذ الصغر.', icon: '🤲', color: 'bg-sky-100' },
    { title: 'الاهتمام بالبيئة', desc: 'حكايات تُسلط الضوء على أهمية الحفاظ على الطبيعة والحيوانات بأسلوب بصري ممتع.', icon: '🌿', color: 'bg-emerald-100' },
    { title: 'حب القراءة والتعلم', desc: 'قصص تُحفز الفضول الفكري وتجعل التعلم مغامرة لا تنتهي.', icon: '📖', color: 'bg-rose-100' },
    { title: 'الشجاعة والمبادرة', desc: 'مواقف تُعلم الطفل كيف يواجه التحديات ويتخذ القرار الصحيح.', icon: '🦁', color: 'bg-orange-100' },
    { title: 'احترام العائلة', desc: 'قيم الأسرة والوالدين في قوالب قصصية دافئة.', icon: '❤️', color: 'bg-pink-100' }
];

const audience = [
    { title: 'الأطفال 4–12 سنة', desc: 'المستفيد الأساسي من المحتوى القصصي.', icon: '🧒' },
    { title: 'الآباء والأمهات', desc: 'المستخدم المباشر والمشرف على التجربة.', icon: '👨‍👩‍👧' },
    { title: 'المدارس والروضات', desc: 'استخدام المنصة كأداة تعليمية تفاعلية.', icon: '🏫' },
    { title: 'المعلمون', desc: 'إنشاء محتوى تعليمي مخصص للطلاب.', icon: '👩‍🏫' }
];
---

<Layout title="قصصنا — حكايتي">
    <section class="section bg-cream-100">
        <div class="container-page text-center max-w-3xl mx-auto">
            <span class="inline-block bg-brand-50 text-brand-600 text-sm font-bold px-4 py-1.5 rounded-full mb-4">الرؤية والرسالة</span>
            <h1 class="text-brand-800">قصص تُربّي جيلاً يفخر بقيمه</h1>
            <p class="mt-5 text-brand-600 text-lg leading-relaxed">
                منصة حكايتي وجهة رقمية مبتكرة تحوّل صورة طفلك إلى قصة وفيلم كرتوني متحرك مخصص، مع تركيز كامل
                على غرس القيم والأخلاق الحميدة. نجمع بين الذكاء الاصطناعي وفن السرد لنجعل من كل طفل بطلاً
                لحكايته الخاصة.
            </p>
        </div>
    </section>

    <section class="section bg-white">
        <div class="container-page">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-brand-800">القيم في صميم المحتوى</h2>
                <p class="mt-3 text-brand-600">نختار القيمة، ونحكي حولها قصة يعيشها الطفل.</p>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    values.map((v) => (
                        <div class="card relative overflow-hidden border border-brand-50">
                            <div class={`w-16 h-16 rounded-2xl ${v.color} flex items-center justify-center text-3xl mb-4`}>{v.icon}</div>
                            <h3 class="text-brand-800 font-extrabold text-lg mb-2">{v.title}</h3>
                            <p class="text-brand-600 leading-relaxed text-sm">{v.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-cream-100">
        <div class="container-page">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-brand-800">لمن نحكي؟</h2>
                <p class="mt-3 text-brand-600">فئات متعددة تستفيد من تجربة حكايتي التفاعلية.</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                {
                    audience.map((a) => (
                        <div class="card text-center">
                            <div class="text-5xl mb-3">{a.icon}</div>
                            <h3 class="text-brand-800 font-extrabold mb-2">{a.title}</h3>
                            <p class="text-brand-600 text-sm leading-relaxed">{a.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-white">
        <div class="container-page">
            <div class="rounded-[40px] overflow-hidden bg-gradient-to-bl from-brand-600 to-brand-700 text-cream-100 p-10 sm:p-16">
                <div class="grid md:grid-cols-2 gap-10 items-center">
                    <div>
                        <span class="inline-block bg-cream-100/10 text-cream-100 text-sm font-bold px-4 py-1.5 rounded-full mb-4">الفرصة السوقية</span>
                        <h2 class="text-cream-100">ثلاث موجات كبرى تلتقي في حكايتي</h2>
                        <p class="mt-4 text-cream-200 leading-relaxed">
                            نقع في تقاطع الذكاء الاصطناعي التوليدي، والتعليم الرقمي، والمحتوى الأخلاقي العربي
                            للأطفال — سوق سريع النمو في منطقة الشرق الأوسط وشمال أفريقيا.
                        </p>
                    </div>
                    <div class="grid grid-cols-3 gap-4 text-center">
                        <div class="rounded-2xl bg-cream-100/10 p-5">
                            <div class="text-3xl font-black">AI</div>
                            <div class="text-xs mt-2 text-cream-200">توليدي</div>
                        </div>
                        <div class="rounded-2xl bg-cream-100/10 p-5">
                            <div class="text-3xl font-black">📚</div>
                            <div class="text-xs mt-2 text-cream-200">تعليم</div>
                        </div>
                        <div class="rounded-2xl bg-cream-100/10 p-5">
                            <div class="text-3xl font-black">❤️</div>
                            <div class="text-xs mt-2 text-cream-200">قيم</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
