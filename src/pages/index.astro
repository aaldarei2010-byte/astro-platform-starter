---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Hero } from '../components/site/Hero.tsx';
import PlaceholderImage from '../components/site/PlaceholderImage.astro';

const WHATSAPP = 'https://wa.me/971502314905';
const INSTAGRAM = 'https://instagram.com/top.ten10';
const MAP = 'https://maps.app.goo.gl/LsSvVrRdR56qeECN6?g_st=ipc';

const nav = [
    { label: 'من نحن', href: '#about' },
    { label: 'رفوفنا', href: '#shelves' },
    { label: 'الأثر', href: '#impact' },
    { label: 'العلامات', href: '#brands' },
    { label: 'قصص', href: '#stories' },
    { label: 'الصور', href: '#gallery' },
    { label: 'تواصل', href: '#contact' }
];

const shelves = [
    { title: 'أكل شعبي إماراتي', desc: 'أطباق بيتية أصيلة بنكهة محلية تحفظ مذاق القوع.', kind: 'food' },
    { title: 'حلويات منزلية', desc: 'حلا طازج من أيادي الأسر المنتجة لكل مناسبة.', kind: 'sweets' },
    { title: 'قهوة ومشروبات', desc: 'قهوة عربية ومشروبات ساخنة وباردة بنكهات دافئة.', kind: 'coffee' },
    { title: 'سندويتشات ووجبات خفيفة', desc: 'خيارات سريعة وشهية تناسب الزيارة العابرة.', kind: 'sandwich' },
    { title: 'منتجات موسمية للمناسبات', desc: 'تشكيلات خاصة للأعياد والمناسبات على مدار العام.', kind: 'gift' }
];

const stats = [
    { value: 'أبريل ٢٠١٩', label: 'انطلاقة توب تن في منطقة القوع' },
    { value: 'مئات', label: 'أسر منتجة عرضت منتجاتها ووصلت لزبائن جدد' },
    { value: '٥ أقسام', label: 'أصناف رئيسية من الطعام والمشروبات على رفوفنا' },
    { value: 'نموّ مستمر', label: 'زيادة في المشاريع المنزلية المحلية وفرص الدخل' }
];

const stories = [
    {
        before: 'بدأت من البيت ببيع بسيط ومحدود.',
        after: 'اليوم منتجاتها على الرفوف ودخلها ارتفع.',
        text: 'أم منتجة بدأت من مطبخها، ومع توب تن أصبح لمنتجها مكان ثابت وزبائن دائمون.'
    },
    {
        before: 'منتج غذائي واحد وعدد قليل من العملاء.',
        after: 'منتج مطوّر وجودة أعلى ووصول أوسع.',
        text: 'صاحبة مشروع غذائي حسّنت منتجها وتغليفه ووصلت إلى عملاء أكثر عبر المحل.'
    },
    {
        before: 'طالبة تجرّب مشروعاً صغيراً للسندويتشات.',
        after: 'تعلّمت البيع والتعامل مع الزبائن بثقة.',
        text: 'شابة بدأت مشروع ساندويتشات وهي طالبة، واكتسبت مهارات بيع وخبرة حقيقية.'
    }
];

const galleryItems = [
    { label: 'رفوف المنتجات', kind: 'package' },
    { label: 'حلويات منزلية', kind: 'sweets' },
    { label: 'قهوة ومشروبات', kind: 'coffee' },
    { label: 'أكل شعبي', kind: 'food' },
    { label: 'تغليف المنتجات', kind: 'gift' },
    { label: 'المحل من الخارج', kind: 'store' }
];

// Placeholder brand slots (logos to be added later). Topten Sweet is the shop
// itself — intentionally NOT listed here as a productive-family brand.
const brandSlots = Array.from({ length: 8 }, (_, i) => `علامة منزلية ${i + 1}`);
---

<SiteLayout>
    <!-- Header / Nav -->
    <header class="sticky top-0 z-50 border-b border-border/70 bg-cream/85 backdrop-blur-md">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3 sm:px-8">
            <a href="#top" class="flex items-center gap-2 no-underline">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-coffee to-gold font-display text-lg font-extrabold text-white shadow-sm">10</span>
                <span class="font-display text-lg font-extrabold text-coffee">توب تن</span>
            </a>

            <nav class="hidden items-center gap-1 md:flex">
                {
                    nav.map((item) => (
                        <a
                            href={item.href}
                            class="rounded-full px-3 py-2 text-sm font-bold text-muted-foreground no-underline transition hover:bg-secondary hover:text-coffee"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>

            <a
                href={WHATSAPP}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground no-underline shadow-sm transition hover:-translate-y-0.5 hover:bg-primary/90"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.728-.978zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                واتساب
            </a>
        </div>
    </header>

    <main id="top">
        <!-- Hero -->
        <Hero client:load primaryHref="#shelves" secondaryHref="#contact" />

        <!-- About -->
        <section id="about" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-20 sm:px-8 sm:py-24">
            <div class="reveal grid gap-10 md:grid-cols-2 md:items-center">
                <div>
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">من نحن</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">أكثر من مجرد محل بيع</h2>
                    <p class="mt-5 text-lg leading-relaxed text-foreground/85">
                        بدأ <strong class="text-coffee">توب تن</strong> في أبريل ٢٠١٩ في منطقة القوع، بهدف دعم الأسر المنتجة
                        وفتح فرصة حقيقية لها لبيع منتجاتها الغذائية في محل منظم وقريب من الناس.
                    </p>
                    <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
                        توب تن ليس مجرد محل. هو مكان يساعد الأسر المنتجة على عرض منتجاتها، تحسين جودتها،
                        الوصول إلى زبائن أكثر، وبناء مصدر دخل مستدام.
                    </p>
                </div>
                <PlaceholderImage kind="store" label="توب تن — القوع" note="ضع هنا صورة المحل" ratio="aspect-[4/3]" class="shadow-xl shadow-coffee/10" />
            </div>
        </section>

        <!-- Shelves -->
        <section id="shelves" class="scroll-mt-24 bg-gradient-to-b from-cream to-muted/60 py-20 sm:py-24">
            <div class="mx-auto max-w-6xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">منتجاتنا</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">ما تجده على رفوفنا</h2>
                    <p class="mt-4 text-lg text-muted-foreground">تشكيلة من صناعة الأسر المنتجة — طعم بيتي تثق فيه.</p>
                </div>

                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {
                        shelves.map((item) => (
                            <article class="reveal group overflow-hidden rounded-3xl border border-border bg-card shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                                <PlaceholderImage kind={item.kind as any} label={item.title} ratio="aspect-[4/3]" class="rounded-none" />
                                <div class="p-5">
                                    <h3 class="font-display text-xl font-extrabold text-coffee">{item.title}</h3>
                                    <p class="mt-2 leading-relaxed text-muted-foreground">{item.desc}</p>
                                </div>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Impact / Stats -->
        <section id="impact" class="scroll-mt-24 py-20 sm:py-24">
            <div class="mx-auto max-w-6xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">الأثر بالأرقام</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">نتائج موثّقة — لا أرقام تسويقية</h2>
                    <p class="mt-4 text-lg text-muted-foreground">أرقام واقعية مستمدة من تقرير تقييم الأثر التنموي ٢٠٢٠–٢٠٢٥، بلا مبالغة.</p>
                </div>

                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                    {
                        stats.map((stat) => (
                            <div class="reveal rounded-3xl border border-border bg-gradient-to-br from-card to-secondary/40 p-7 text-center shadow-sm">
                                <div class="font-display text-3xl font-extrabold text-primary sm:text-4xl">{stat.value}</div>
                                <p class="mt-3 leading-relaxed text-muted-foreground">{stat.label}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Brands -->
        <section id="brands" class="scroll-mt-24 bg-coffee py-20 text-white sm:py-24">
            <div class="mx-auto max-w-6xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-white/15 px-4 py-1 text-sm font-bold text-cream">شركاؤنا</span>
                    <h2 class="font-display text-3xl font-extrabold text-white sm:text-4xl">بيت لمئات العلامات المنزلية</h2>
                    <p class="mt-4 text-lg text-cream/80">كل علامة هنا قصة أسرة منتجة. أضف شعارات البراندات لاحقاً مكان البطاقات.</p>
                </div>

                <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
                    {
                        brandSlots.map((name) => (
                            <div class="reveal flex aspect-[3/2] flex-col items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 p-4 text-center backdrop-blur-sm transition hover:bg-white/10">
                                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold/30 font-display text-base font-extrabold text-cream">★</span>
                                <span class="text-sm font-bold text-cream">{name}</span>
                                <span class="text-[11px] text-cream/50">شعار العلامة</span>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Stories -->
        <section id="stories" class="scroll-mt-24 py-20 sm:py-24">
            <div class="mx-auto max-w-6xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">قصص قبل وبعد</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">أثر يُقاس بحياة الناس</h2>
                    <p class="mt-4 text-lg text-muted-foreground">
                        ثلاث قصص موثّقة في تقرير تقييم الأثر التنموي ٢٠٢٠–٢٠٢٥، توضّح كيف ساعد توب تن الأسر المنتجة
                        على الانتقال من البيع البسيط إلى دخل أفضل وثقة أكبر.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
                    {
                        stories.map((story, i) => (
                            <article class="reveal flex flex-col rounded-3xl border border-border bg-card p-6 shadow-sm">
                                <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-full bg-primary/10 font-display text-lg font-extrabold text-primary">
                                    {['١', '٢', '٣'][i]}
                                </span>
                                <p class="leading-relaxed text-foreground/85">{story.text}</p>
                                <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
                                    <div class="rounded-xl bg-muted p-3">
                                        <div class="mb-1 font-bold text-muted-foreground">قبل</div>
                                        <div class="text-foreground/80">{story.before}</div>
                                    </div>
                                    <div class="rounded-xl bg-secondary/70 p-3">
                                        <div class="mb-1 font-bold text-coffee">بعد</div>
                                        <div class="text-foreground/80">{story.after}</div>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>
                <p class="reveal mt-6 text-center text-sm text-muted-foreground">حفاظاً على الخصوصية، لا نذكر أسماء الأشخاص في هذه القصص.</p>
            </div>
        </section>

        <!-- Gallery -->
        <section id="gallery" class="scroll-mt-24 bg-gradient-to-b from-muted/60 to-cream py-20 sm:py-24">
            <div class="mx-auto max-w-6xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">معرض الصور</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">لمحة من توب تن</h2>
                    <p class="mt-4 text-lg text-muted-foreground">المنتجات، الرفوف، والتغليف — استبدل هذه البطاقات بصور المحل الحقيقية.</p>
                </div>

                <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                    {
                        galleryItems.map((item, i) => (
                            <PlaceholderImage
                                kind={item.kind as any}
                                label={item.label}
                                ratio={i % 5 === 0 ? 'aspect-square sm:row-span-2 sm:aspect-[3/4]' : 'aspect-square'}
                                class="reveal shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
                            />
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Contact -->
        <section id="contact" class="scroll-mt-24 py-20 sm:py-24">
            <div class="mx-auto max-w-5xl px-5 sm:px-8">
                <div class="reveal mx-auto mb-12 max-w-2xl text-center">
                    <span class="mb-3 inline-block rounded-full bg-secondary px-4 py-1 text-sm font-bold text-secondary-foreground">تواصل معنا</span>
                    <h2 class="font-display text-3xl font-extrabold text-coffee sm:text-4xl">زورونا في القوع</h2>
                    <p class="mt-4 text-lg text-muted-foreground">داخل حديقة القوع للعوائل — عند المدخل.</p>
                </div>

                <div class="reveal grid gap-6 md:grid-cols-2">
                    <div class="space-y-4 rounded-3xl border border-border bg-card p-7 shadow-sm">
                        <div class="flex items-start gap-4">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-lg font-extrabold text-coffee">الموقع</h3>
                                <p class="mt-1 text-muted-foreground">القوع — العين — أبوظبي · داخل حديقة القوع للعوائل عند المدخل.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-lg font-extrabold text-coffee">ساعات العمل</h3>
                                <p class="mt-1 text-muted-foreground">يومياً من ٧ صباحاً حتى ١٢ منتصف الليل.</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
                            </span>
                            <div>
                                <h3 class="font-display text-lg font-extrabold text-coffee">إنستغرام</h3>
                                <a href={INSTAGRAM} target="_blank" rel="noopener" class="mt-1 inline-block font-bold text-primary no-underline hover:underline">@top.ten10</a>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col justify-center gap-4 rounded-3xl bg-gradient-to-br from-coffee to-date p-7 text-center text-white shadow-lg">
                        <h3 class="font-display text-2xl font-extrabold">جاهز للزيارة أو الطلب؟</h3>
                        <p class="text-cream/85">راسلنا على واتساب أو افتح الموقع على الخريطة مباشرة.</p>
                        <a
                            href={WHATSAPP}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 font-bold text-coffee no-underline shadow-sm transition hover:-translate-y-0.5"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.728-.978zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                            تواصل عبر واتساب
                        </a>
                        <a
                            href={MAP}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/40 bg-white/10 px-6 py-3 font-bold text-white no-underline backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                            افتح الموقع على الخريطة
                        </a>
                        <p class="mt-1 text-sm text-cream/80" dir="ltr">+971 50 231 4905</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-border bg-cream py-10">
