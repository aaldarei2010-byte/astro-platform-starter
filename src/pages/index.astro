---
import Layout from '../layouts/Layout.astro';
import StoryCard from '../components/StoryCard.astro';

const steps = [
    {
        title: 'ارفع الصورة',
        description: 'اختر صورة واضحة لطفلك لبدء السحر',
        icon: 'upload'
    },
    {
        title: 'الذكاء الاصطناعي يصنع القصة',
        description: 'تقنيتنا تحول الصورة إلى شخصية متحركة في قصة مفيدة',
        icon: 'wand'
    },
    {
        title: 'شاهد كرتون طفلك',
        description: 'استمتع بمشاهدة طفلك بطلاً في مغامرة متحركة',
        icon: 'play'
    }
];

const stories = [
    { title: 'الصدق والأمانة', emoji: '🍎', gradient: 'bg-gradient-to-br from-emerald-200 via-green-300 to-emerald-400' },
    { title: 'مساعدة الآخرين', emoji: '🤝', gradient: 'bg-gradient-to-br from-sky-200 via-cyan-300 to-blue-400' },
    { title: 'الاهتمام بالبيئة', emoji: '🌱', gradient: 'bg-gradient-to-br from-lime-200 via-green-300 to-teal-400' },
    { title: 'حب القراءة', emoji: '📚', gradient: 'bg-gradient-to-br from-amber-200 via-orange-300 to-rose-300' }
];

const values = [
    { title: 'الصدق والأمانة', desc: 'قصص تُبرز أهمية قول الحقيقة والوفاء بالوعود.', icon: '⭐' },
    { title: 'مساعدة الآخرين', desc: 'مغامرات تُشجع على التعاون وتقديم يد العون.', icon: '🤲' },
    { title: 'الاهتمام بالبيئة', desc: 'حكايات تُسلط الضوء على الحفاظ على الطبيعة.', icon: '🌿' },
    { title: 'حب القراءة والتعلم', desc: 'قصص تُحفز الفضول وتجعل التعلم مغامرة.', icon: '📖' },
    { title: 'الشجاعة والمبادرة', desc: 'مواقف تُعلم الطفل مواجهة التحديات بثقة.', icon: '🦁' },
    { title: 'احترام الوالدين', desc: 'قيم راسخة تُقرب الطفل من عائلته.', icon: '❤️' }
];
---

<Layout>
    <section class="relative overflow-hidden">
        <div class="grid lg:grid-cols-2 min-h-[560px]">
            <div class="bg-cream-100 order-2 lg:order-1 flex items-center relative">
                <div class="hidden lg:block absolute top-1/2 -translate-y-1/2 left-0 w-40 h-1 arrow-sweep opacity-60"></div>
                <div class="container-page py-12 lg:py-20 relative">
                    <h1 class="text-brand-800">
                        حول صورة طفلك إلى<br />
                        <span class="text-brand-600">قصة متحركة</span> بلمسة سحرية
                    </h1>
                    <p class="mt-5 text-lg text-brand-600 leading-relaxed max-w-lg">
                        تعليمية، ترفيهية، ومليئة بالقيم الأخلاقية
                    </p>

                    <div class="mt-10 relative">
                        <div class="relative rounded-[40px] overflow-hidden border-[6px] border-gold-400 shadow-2xl aspect-[16/9] bg-gradient-to-br from-emerald-200 via-green-300 to-teal-400 flex items-end justify-center">
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="text-8xl">🚴</span>
                            </div>
                            <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/40"></div>
                            <div class="absolute bottom-6 left-6 w-10 h-10 rounded-full bg-white/30"></div>
                        </div>
                        <div class="absolute -bottom-5 right-8 bg-cream-100 px-4 py-2 rounded-full shadow-md font-bold text-brand-700">
                            قصة متحركة مخصصة
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-brand-600 order-1 lg:order-2 flex items-center justify-center relative min-h-[400px] lg:min-h-0">
                <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 40%, #ffd166 1px, transparent 1px), radial-gradient(circle at 70% 60%, #ffd166 1px, transparent 1px); background-size: 40px 40px;"></div>
                <div class="relative">
                    <div class="w-72 h-72 sm:w-96 sm:h-96 rounded-full overflow-hidden border-[6px] border-cream-200 shadow-2xl bg-gradient-to-br from-emerald-100 to-green-200 flex items-center justify-center">
                        <span class="text-9xl">🧒</span>
                    </div>
                    <div class="absolute -bottom-4 right-1/2 translate-x-1/2 bg-cream-100 text-brand-700 px-5 py-2 rounded-full font-bold shadow-md whitespace-nowrap">
                        صورة طفلك الحقيقية
                    </div>
                </div>
                <div class="absolute top-1/3 right-8 text-gold-400 text-3xl animate-pulse">✨</div>
                <div class="absolute bottom-1/3 left-8 text-gold-400 text-2xl animate-pulse">⭐</div>
            </div>
        </div>
    </section>

    <section class="bg-accent-400 text-white">
        <div class="container-page py-16">
            <div class="grid md:grid-cols-3 gap-6">
                {
                    steps.map((step) => (
                        <div class="bg-white text-brand-800 rounded-3xl p-8 text-center shadow-xl">
                            <div class="mx-auto w-14 h-14 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center mb-4">
                                {step.icon === 'upload' && (
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" />
                                    </svg>
                                )}
                                {step.icon === 'wand' && (
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M15 4V2M15 16v-2M8 9h2M20 9h2M17.8 11.8L19 13M15 9h.01M17.8 6.2L19 5M3 21l9-9M12.2 6.2L11 5" />
                                    </svg>
                                )}
                                {step.icon === 'play' && (
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="3" width="18" height="18" rx="3" />
                                        <path d="M10 9l5 3-5 3V9z" fill="currentColor" />
                                    </svg>
                                )}
                            </div>
                            <h3 class="text-xl font-extrabold mb-2">{step.title}</h3>
                            <p class="text-brand-600 text-sm leading-relaxed">{step.description}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section bg-cream-100">
        <div class="container-page">
            <div class="flex items-end justify-between mb-10">
                <div>
                    <h2 class="text-brand-800">مقتطفات من قصصنا</h2>
                    <p class="mt-2 text-brand-600">قيم أخلاقية في قوالب بصرية تأسر انتباه الأطفال.</p>
                </div>
                <a href="/library" class="hidden sm:inline-flex btn btn-ghost">شاهد المكتبة</a>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
                {stories.map((s) => <StoryCard title={s.title} emoji={s.emoji} gradient={s.gradient} />)}
            </div>
        </div>
    </section>

    <section class="section bg-white">
        <div class="container-page">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="inline-block bg-brand-50 text-brand-600 text-sm font-bold px-4 py-1.5 rounded-full mb-4">القيم في صميم المحتوى</span>
                <h2 class="text-brand-800">قصص تُربّي قبل أن تُسلي</h2>
                <p class="mt-3 text-brand-600">كل قصة مصممة بعناية حول قيمة أخلاقية يحتاجها طفلك في رحلة نموه.</p>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    values.map((v) => (
                        <div class="card border border-brand-50">
                            <div class="w-12 h-12 rounded-2xl bg-cream-200 flex items-center justify-center text-2xl mb-4">{v.icon}</div>
                            <h3 class="text-brand-800 font-extrabold text-lg mb-2">{v.title}</h3>
                            <p class="text-brand-600 leading-relaxed text-sm">{v.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container-page">
            <div class="relative overflow-hidden rounded-[40px] bg-brand-600 text-cream-100 p-10 sm:p-16 text-center">
                <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-accent-400/30 blur-3xl"></div>
                <div class="absolute -bottom-10 -left-10 w-48 h-48 rounded-full bg-gold-400/30 blur-3xl"></div>
                <div class="relative">
                    <h2 class="text-cream-100">جاهز لتجعل طفلك بطل حكايته؟</h2>
                    <p class="mt-3 text-cream-200 max-w-xl mx-auto">ارفع الصورة، اختر القيمة، واستلم قصة أو فيلم كرتوني مخصص خلال دقائق.</p>
                    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                        <a href="/create" class="btn btn-accent btn-lg">ابدأ قصة جديدة</a>
                        <a href="/pricing" class="btn btn-ghost btn-lg !text-cream-100 !border-cream-100 hover:!bg-cream-100 hover:!text-brand-700">الأسعار</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>
