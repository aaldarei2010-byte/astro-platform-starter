---
import Layout from '../layouts/Layout.astro';

const perItem = [
    {
        title: 'قصة كتاب',
        badge: 'الأكثر طلباً',
        price: '50',
        currency: 'درهم',
        unit: '/ قصة',
        emoji: '📖',
        features: [
            'كتاب مصور مخصص يظهر فيه طفلك كبطل',
            'اختيار القيمة الأخلاقية والبيئة',
            'قابل للتحميل بصيغة PDF',
            'مناسب للطباعة بجودة عالية',
            'تسليم خلال دقائق'
        ],
        cta: 'أنشئ كتاباً',
        href: '/create?type=book',
        highlight: false
    },
    {
        title: 'فيلم كرتون',
        badge: 'تجربة سحرية',
        price: '80',
        currency: 'درهم',
        unit: '/ فيلم',
        emoji: '🎬',
        features: [
            'فيلم متحرك 2–5 دقائق بطلُه طفلك',
            'مؤثرات صوتية وموسيقى لطيفة',
            'تعليق عربي فصيح أو لهجة مختارة',
            'تحميل بجودة عالية (HD)',
            'قابل للمشاركة مع العائلة'
        ],
        cta: 'أنشئ فيلماً',
        href: '/create?type=video',
        highlight: true
    }
];

const plans = [
    {
        title: 'الباقة المجانية',
        price: '0',
        unit: 'للتجربة',
        features: ['قصة واحدة شهرياً', 'جودة قياسية', 'حفظ في مكتبتك'],
        cta: 'ابدأ مجاناً',
        href: '/create',
        highlight: false
    },
    {
        title: 'الباقة العائلية',
        price: '99',
        unit: '/ شهرياً',
        features: [
            'قصص وأفلام غير محدودة',
            'جميع أفراد الأسرة',
            'أولوية في التسليم',
            'جودة عالية (HD)'
        ],
        cta: 'اشترك الآن',
        href: '/create?plan=family',
        highlight: true
    },
    {
        title: 'باقة المدارس',
        price: 'حسب الطلب',
        unit: 'اشتراك مؤسسي',
        features: [
            'لوحة تحكم للمعلمين',
            'تقارير متابعة للطلاب',
            'محتوى مصمم لمنهج الصف',
            'دعم مخصص'
        ],
        cta: 'تواصل معنا',
        href: 'mailto:schools@hikayati.com',
        highlight: false
    }
];
---

<Layout title="الأسعار — حكايتي">
    <section class="section bg-cream-100">
        <div class="container-page text-center max-w-3xl mx-auto">
            <span class="inline-block bg-brand-50 text-brand-600 text-sm font-bold px-4 py-1.5 rounded-full mb-4">الأسعار</span>
            <h1 class="text-brand-800">أسعار واضحة، قيمة لا تُقدّر بثمن</h1>
            <p class="mt-4 text-brand-600 text-lg">ادفع لكل قصة، أو اشترك بباقة شهرية غير محدودة.</p>
        </div>
    </section>

    <section class="pb-8 bg-cream-100">
        <div class="container-page grid md:grid-cols-2 gap-6">
            {
                perItem.map((item) => (
                    <div class={`card relative overflow-hidden ${item.highlight ? 'ring-4 ring-accent-400 bg-gradient-to-bl from-white to-cream-100' : ''}`}>
                        <span class="absolute top-6 left-6 bg-brand-600 text-cream-100 text-xs font-bold px-3 py-1 rounded-full">
                            {item.badge}
                        </span>
                        <div class="text-6xl mb-4">{item.emoji}</div>
                        <h3 class="text-brand-800 text-2xl font-extrabold mb-1">{item.title}</h3>
                        <div class="flex items-baseline gap-2 mt-2 mb-6">
                            <span class="text-5xl font-black text-brand-700">{item.price}</span>
                            <span class="text-lg font-bold text-brand-600">{item.currency}</span>
                            <span class="text-sm text-brand-500">{item.unit}</span>
                        </div>
                        <ul class="space-y-3 mb-8">
                            {item.features.map((f) => (
                                <li class="flex items-start gap-2 text-brand-700">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-accent-500 shrink-0 mt-0.5">
                                        <path d="M5 12l4 4L19 7" />
                                    </svg>
                                    <span class="text-sm leading-relaxed">{f}</span>
                                </li>
                            ))}
                        </ul>
                        <a href={item.href} class={`btn ${item.highlight ? 'btn-accent' : 'btn-primary'} w-full`}>
                            {item.cta}
                        </a>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="plans" class="section bg-white">
        <div class="container-page">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <h2 class="text-brand-800">الباقات الشهرية</h2>
                <p class="mt-3 text-brand-600">اختر الباقة المناسبة لعائلتك أو مؤسستك.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-6">
                {
                    plans.map((p) => (
                        <div class={`card relative ${p.highlight ? 'ring-4 ring-brand-600 scale-105' : ''}`}>
                            {p.highlight && (
                                <span class="absolute -top-3 right-6 bg-accent-500 text-white text-xs font-bold px-3 py-1 rounded-full">الأكثر شعبية</span>
                            )}
                            <h3 class="text-brand-800 text-xl font-extrabold mb-2">{p.title}</h3>
                            <div class="flex items-baseline gap-2 mb-6">
                                <span class="text-4xl font-black text-brand-700">{p.price}</span>
                                <span class="text-sm text-brand-500">{p.unit}</span>
                            </div>
                            <ul class="space-y-3 mb-8">
                                {p.features.map((f) => (
                                    <li class="flex items-start gap-2 text-brand-700 text-sm">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="text-accent-500 shrink-0 mt-0.5">
                                            <path d="M5 12l4 4L19 7" />
                                        </svg>
                                        <span>{f}</span>
                                    </li>
                                ))}
                            </ul>
                            <a href={p.href} class={`btn ${p.highlight ? 'btn-primary' : 'btn-ghost'} w-full`}>
                                {p.cta}
                            </a>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="schools" class="section bg-cream-100">
        <div class="container-page">
            <div class="card border-2 border-brand-100 p-10 sm:p-14 grid md:grid-cols-[2fr_1fr] gap-10 items-center">
                <div>
                    <span class="inline-block bg-brand-50 text-brand-600 text-sm font-bold px-3 py-1 rounded-full mb-3">للمدارس والروضات</span>
                    <h2 class="text-brand-800">قصص مخصصة لكل طالب</h2>
                    <p class="mt-3 text-brand-600 leading-relaxed">
                        قدّم لكل طالب في صفك تجربة قصصية مخصصة حوله. لوحة تحكم للمعلم، تقارير متابعة، ومحتوى مرتبط بمنهجك.
                    </p>
                </div>
                <div class="text-center md:text-left">
                    <a href="mailto:schools@hikayati.com" class="btn btn-primary btn-lg">اطلب عرض سعر</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
